{
  "formatVersion": 1,
  "name": "continual-harness",
  "description": "A minimal Actor-Refiner Swarm inspired by the Continual Harness pattern.",
  "definition": {
    "agents": [
      {
        "id": "actor",
        "harness": "codex",
        "model": "gpt-5.6-terra",
        "effort": "high",
        "turnPolicy": "single-event"
      },
      {
        "id": "refiner",
        "harness": "codex",
        "model": "gpt-5.6-terra",
        "effort": "high",
        "turnPolicy": "single-event"
      }
    ],
    "routes": [
      {
        "from": "actor",
        "to": "refiner"
      }
    ],
    "pluginIngress": [],
    "plugins": [],
    "tests": [
      {
        "id": "actor-completes-task",
        "inputEvents": [
          {
            "type": "communication.sent",
            "data": {
              "from": "test/actor-completes-task",
              "to": ["agent/actor"],
              "content": [
                {
                  "type": "text",
                  "text": "Produce a concise answer and report completion."
                }
              ]
            }
          }
        ],
        "expect": {
          "eventType": "agent.turn.recorded"
        }
      }
    ]
  },
  "workspaces": {
    "actor": "agents/actor",
    "refiner": "agents/refiner"
  },
  "pluginBundles": {},
  "source": {
    "revisionId": null,
    "agentHeads": {}
  }
}

{
  "formatVersion": 1,
  "name": "continual-harness",
  "description": "A minimal Actor-Refiner Swarm inspired by the Continual Harness pattern.",
  "definition": {
    "agents": [
      {
        "id": "actor",
        "harness": "codex"
      },
      {
        "id": "refiner",
        "harness": "codex"
      }
    ],
    "routes": [
      {
        "on": "task.requested",
        "to": "actor"
      },
      {
        "on": "task.completed",
        "to": "refiner"
      }
    ],
    "externalChannels": [],
    "plugins": [],
    "tests": [
      {
        "id": "actor-completes-task",
        "inputEvents": [
          {
            "type": "task.requested",
            "data": {
              "task": "Produce a concise answer and record completion."
            }
          }
        ],
        "expect": {
          "eventType": "task.completed"
        }
      }
    ]
  },
  "workspaces": {
    "actor": "agents/actor",
    "refiner": "agents/refiner"
  },
  "source": {
    "revisionId": null,
    "agentHeads": {}
  }
}
